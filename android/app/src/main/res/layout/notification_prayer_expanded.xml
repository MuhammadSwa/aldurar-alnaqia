<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded prayer-times notification layout.
     Top row: Chronometer on the left, Hijri date on the right, day name removed.
     Table row: 6 equal columns (prayer1 through prayer6) dynamically bound
     so that Fajr is ALWAYS on the physical right and Isha is ALWAYS on the physical left,
     regardless of device locale. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <!-- Top row: Chronometer on the physical left, Hijri date on the physical right -->
    <RelativeLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Chronometer
            android:id="@+id/chronometer"
            style="@android:style/TextAppearance.Material.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:textSize="13sp"
            android:textDirection="ltr"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hijri_date"
            style="@android:style/TextAppearance.Material.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_toRightOf="@id/chronometer"
            android:layout_centerVertical="true"
            android:gravity="right|center_vertical"
            android:textAlignment="viewEnd"
            android:textDirection="rtl"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </RelativeLayout>

    <!-- Horizontal prayer-times table: 6 columns bound dynamically to ensure strict RTL -->
    <LinearLayout
        android:id="@+id/table_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Slot 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/prayer1_name"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/prayer1_time"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Slot 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/prayer2_name"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/prayer2_time"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Slot 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/prayer3_name"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/prayer3_time"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Slot 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/prayer4_name"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/prayer4_time"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Slot 5 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/prayer5_name"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/prayer5_time"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Slot 6 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/prayer6_name"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/prayer6_time"
                style="@android:style/TextAppearance.Material.Notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
